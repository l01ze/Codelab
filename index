/* =========================================================
   Context menus
   ========================================================= */
const ctx = $('ctxMenu');
function showContextMenu(x, y, ent) {
  ctx.innerHTML = '';
  const items = [];
  if (!ent.isDir) {
    items.push(['▶ Run', () => { openFile(ent.path); runCurrent(); }]);
    items.push(['⤓ Download', () => downloadFile(ent.path)]);
    items.push(['⧉ Duplicate', () => duplicateFile(ent.path)]);
    items.push(['sep']);
  }
  items.push(['✎ Rename', 'F2', () => {
    const row = treeEl.querySelector(`[data-path="${CSS.escape(ent.path)}"]`);
    if (row) startRename(row, ent);
  }]);
  items.push(['⧉ Copy', 'Ctrl+C', () => navigator.clipboard.writeText(ent.path).then(() => logLine('info', 'copied: ' + ent.path))]);
  items.push(['📋 Copy Path', '', () => navigator.clipboard.writeText(ent.path).then(() => logLine('info', 'copied path: ' + ent.path))]);
  items.push(['sep']);
  items.push(['+ New File', '', () => {
    const base = ent.isDir ? ent.path + '/' : ent.path.split('/').slice(0,-1).join('/') + '/';
    openModal('new-file', 'New file', base + 'name.ext', '');
  }]);
  if (ent.isDir) items.push(['▤ New Folder', '', () => openModal('new-folder', 'New folder', ent.path + '/subfolder', '')]);
  items.push(['sep']);
  items.push(['✖ Delete', '', () => deletePath(ent.path, ent.isDir), 'danger']);

  for (const [label, key, fn, cls] of items) {
    if (label === 'sep') { const s = document.createElement('div'); s.className = 'sep'; ctx.appendChild(s); continue; }
    const it = document.createElement('div');
    it.className = 'item' + (cls ? ' ' + cls : '');
    it.innerHTML = `<span>${label}</span>${key ? `<span class="key">${key}</span>` : ''}`;
    it.onclick = () => { ctx.classList.remove('open'); fn(); };
    ctx.appendChild(it);
  }
  ctx.style.left = Math.min(x, innerWidth - 220) + 'px';
  ctx.style.top  = Math.min(y, innerHeight - 300) + 'px';
  ctx.classList.add('open');
}
function showTabContextMenu(x, y, path) {
  ctx.innerHTML = '';
  const items = [
    ['Close', 'Ctrl+W', () => closeTab(path)],
    ['Close Others', '', () => { state.open = [path]; state.active = path; renderTabs(); renderTree(); loadIntoEditor(); }],
    ['Close All', '', () => { state.open = []; state.active = null; renderTabs(); renderTree(); loadIntoEditor(); }],
    ['sep'],
    ['Reveal in Explorer', '', () => { const row = treeEl.querySelector(`[data-path="${CSS.escape(path)}"]`); if (row) row.scrollIntoView({ block: 'center' }); }],
    ['Copy Path', '', () => navigator.clipboard.writeText(path)]
  ];
  for (const [label, key, fn] of items) {
    if (label === 'sep') { const s = document.createElement('div'); s.className = 'sep'; ctx.appendChild(s); continue; }
    const it = document.createElement('div');
    it.className = 'item';
    it.innerHTML = `<span>${label}</span>${key ? `<span class="key">${key}</span>` : ''}`;
    it.onclick = () => { ctx.classList.remove('open'); fn(); };
    ctx.appendChild(it);
  }
  ctx.style.left = Math.min(x, innerWidth - 220) + 'px';
  ctx.style.top = Math.min(y, innerHeight - 200) + 'px';
  ctx.classList.add('open');
}
document.addEventListener('click', (e) => { if (!ctx.contains(e.target)) ctx.classList.remove('open'); });

function duplicateFile(path) {
  const dir = path.split('/').slice(0, -1).join('/');
  const name = path.split('/').pop();
  const dot = name.lastIndexOf('.');
  const base = dot > 0 ? name.slice(0, dot) : name;
  const ext = dot > 0 ? name.slice(dot) : '';
  let i = 1, newPath;
  do { newPath = (dir ? dir + '/' : '') + base + ' copy' + (i > 1 ? ' ' + i : '') + ext; i++; }
  while (state.files[newPath] != null);
  state.files[newPath] = state.files[path];
  logLine('info', `duplicated → ${newPath}`);
  openFile(newPath);
}

/* =========================================================
   Download / export / import
   ========================================================= */
function downloadFile(path) {
  const data = state.files[path];
  if (data == null) return;
  let blob;
  if (isBinaryData(data)) {
    const [meta, b64] = data.split(',');
    const mime = meta.match(/data:([^;]+)/)[1];
    blob = new Blob([Uint8Array.from(atob(b64), c => c.charCodeAt(0))], { type: mime });
  } else blob = new Blob([data], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = path.split('/').pop();
  a.click();
}

if ($('btnExport')) {
  $('btnExport').onclick = async () => {
    if (typeof JSZip === 'undefined') { logLine('error', 'JSZip failed to load'); return; }
    const zip = new JSZip();
    for (const [path, content] of Object.entries(state.files)) {
      if (isBinaryData(content)) {
        const [, b64] = content.split(',');
        zip.file(path, b64, { base64: true });
      } else zip.file(path, content);
    }
    const blob = await zip.generateAsync({ type: 'blob' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = state.projectName + '.zip';
    a.click();
    logLine('ok', `exported ${Object.keys(state.files).length} files as zip`);
  };
}

async function readFileAsTextOrData(file) {
  if (file.type.startsWith('image/') || /\.(png|jpe?g|gif|webp|bmp|ico|woff2?|ttf|otf)$/i.test(file.name)) {
    return await new Promise((res) => { const r = new FileReader(); r.onload = () => res(r.result); r.readAsDataURL(file); });
  }
  return await file.text();
}
async function importFiles(fileList, baseDir) {
  let count = 0;
  for (const file of fileList) {
    const rel = file.webkitRelativePath || file.name;
    const path = baseDir ? baseDir + '/' + rel : rel;
    try { state.files[path] = await readFileAsTextOrData(file); count++; }
    catch (e) { logLine('error', `import failed for ${rel}: ${e.message}`); }
  }
  renderTree(); scheduleSave();
  logLine('ok', `imported ${count} file${count === 1 ? '' : 's'}`);
}
if ($('btnImportFiles')) {
  $('btnImportFiles').onclick = () => {
    const inp = document.createElement('input');
    inp.type = 'file'; inp.multiple = true;
    inp.onchange = () => importFiles(inp.files);
    inp.click();
  };
}
if ($('btnImportFolder')) {
  $('btnImportFolder').onclick = () => {
    const inp = document.createElement('input');
    inp.type = 'file'; inp.multiple = true; inp.webkitdirectory = true;
    inp.onchange = () => importFiles(inp.files);
    inp.click();
  };
}
async function importDataTransfer(dt, baseDir) {
  const items = [...(dt.items || [])];
  let count = 0;
  for (const it of items) {
    if (it.kind !== 'file') continue;
    const entry = it.webkitGetAsEntry ? it.webkitGetAsEntry() : null;
    if (entry) count += await walkEntry(entry, baseDir || '');
    else { const f = it.getAsFile(); if (f) { await importFiles([f], baseDir); count++; } }
  }
  renderTree(); scheduleSave();
  logLine('ok', `dropped ${count} item${count === 1 ? '' : 's'}`);
}
function walkEntry(entry, baseDir) {
  return new Promise((resolve) => {
    const path = baseDir ? baseDir + '/' + entry.name : entry.name;
    if (entry.isFile) {
      entry.file(async (f) => { state.files[path] = await readFileAsTextOrData(f); resolve(1); }, () => resolve(0));
    } else if (entry.isDirectory) {
      state.folders.add(path); state.expanded.add(path);
      const reader = entry.createReader();
      const all = [];
      const readBatch = () => {
        reader.readEntries(async (entries) => {
          if (!entries.length) {
            let total = 0;
            for (const e of all) total += await walkEntry(e, path);
            resolve(total); return;
          }
          all.push(...entries); readBatch();
        }, () => resolve(0));
      };
      readBatch();
    } else resolve(0);
  });
}
['dragenter','dragover'].forEach(ev => {
  document.addEventListener(ev, (e) => {
    if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) {
      e.preventDefault(); $('dropOverlay').classList.add('show');
    }
  });
});
document.addEventListener('dragleave', (e) => {
  if (e.clientX <= 0 || e.clientY <= 0 || e.clientX >= innerWidth || e.clientY >= innerHeight)
    $('dropOverlay').classList.remove('show');
});
document.addEventListener('drop', async (e) => {
  if (!e.dataTransfer) return;
  e.preventDefault();
  $('dropOverlay').classList.remove('show');
  if (e.target.closest('#tree .row')) return;
  await importDataTransfer(e.dataTransfer, '');
});

/* =========================================================
   Global shortcuts
   ========================================================= */
let pendingCtrlK = 0;
window.addEventListener('keydown', (e) => {
  const mod = e.ctrlKey || e.metaKey;
  const key = e.key;

  if (mod && key.toLowerCase() === 'k') { e.preventDefault(); pendingCtrlK = Date.now(); return; }
  if (!mod && key.toLowerCase() === 'z' && Date.now() - pendingCtrlK < 800) {
    state.zen = !state.zen; applyLayout(); pendingCtrlK = 0; return;
  }
  if (mod && e.shiftKey && key.toLowerCase() === 'p') { e.preventDefault(); openCommandPalette(); }
  else if (mod && e.shiftKey && key.toLowerCase() === 'f') { e.preventDefault(); setActiveView('search'); }
  else if (mod && e.shiftKey && key.toLowerCase() === 'e') { e.preventDefault(); setActiveView('explorer'); }
  else if (mod && e.shiftKey && key.toLowerCase() === 'g') { e.preventDefault(); setActiveView('scm'); }
  else if (mod && e.shiftKey && key.toLowerCase() === 'd') { e.preventDefault(); setActiveView('run'); }
  else if (mod && e.shiftKey && key.toLowerCase() === 'x') { e.preventDefault(); setActiveView('extensions'); }
  else if (mod && key === '`') { e.preventDefault(); if (e.shiftKey) openPanel('terminal'); else togglePanel(); }
  else if (mod && key.toLowerCase() === 'p') { e.preventDefault(); openQuickOpen(); }
  else if (mod && key.toLowerCase() === 's') { e.preventDefault(); saveCurrent(); }
  else if (mod && key === 'Enter') { e.preventDefault(); runCurrent(); }
  else if (mod && key.toLowerCase() === 'n') { e.preventDefault(); openNewFileModal(); }
  else if (mod && key.toLowerCase() === 'b') { e.preventDefault(); $('sidebar').classList.toggle('hidden'); $('splitterSidebar').style.display = $('sidebar').classList.contains('hidden') ? 'none' : ''; }
  else if (mod && key.toLowerCase() === 'j') { e.preventDefault(); togglePanel(); }
  else if (mod && key.toLowerCase() === 'w' && state.active) { e.preventDefault(); closeTab(state.active); }
  else if (mod && (key === '=' || key === '+')) { e.preventDefault(); state.fontSize = Math.min(24, state.fontSize + 1); if (editor) editor.updateOptions({ fontSize: state.fontSize }); const f = $('setFontSize'); if (f) f.value = state.fontSize; scheduleSave(); }
  else if (mod && key === '-') { e.preventDefault(); state.fontSize = Math.max(10, state.fontSize - 1); if (editor) editor.updateOptions({ fontSize: state.fontSize }); const f = $('setFontSize'); if (f) f.value = state.fontSize; scheduleSave(); }
  else if (e.altKey && key.toLowerCase() === 'z') { e.preventDefault(); state.wordWrap = !state.wordWrap; if (editor) editor.updateOptions({ wordWrap: state.wordWrap ? 'on' : 'off' }); scheduleSave(); }
  else if (e.key === 'Escape') {
    if ($('modal').classList.contains('open')) closeModal();
    if (overlay.classList.contains('open')) closeOverlay();
    closeAllMenus();
    if (state.zen) { state.zen = false; applyLayout(); }
  }
});

/* =========================================================
   Boot
   ========================================================= */
(async function bootApp() {
  try {
    progress(15, 'restoring workspace…');
    const saved = await loadAll();
    if (saved && saved.files && Object.keys(saved.files).length) {
      state.files = saved.files;
      state.folders = new Set(saved.folders || []);
      state.langOverride = saved.langOverride || {};
      state.expanded = new Set(saved.expanded || []);
      state.open = saved.open || [];
      state.active = saved.active || null;
      state.projectName = saved.projectName || 'untitled';
      if (saved.theme) state.theme = saved.theme;
      if (saved.fontSize) state.fontSize = saved.fontSize;
      if (saved.minimap != null) state.minimap = saved.minimap;
      if (saved.wordWrap != null) state.wordWrap = saved.wordWrap;
      if (saved.tabSize) state.tabSize = saved.tabSize;
      if (saved.sidebarW) state.sidebarW = saved.sidebarW;
      if (saved.secondaryW) state.secondaryW = saved.secondaryW;
      if (saved.panelH) state.panelH = saved.panelH;
      if (saved.activeView) state.activeView = saved.activeView;
    } else {
      state.files = { ...DEFAULT.files };
      state.folders = new Set(DEFAULT.folders);
      state.projectName = DEFAULT.projectName;
      state.expanded = new Set(DEFAULT.folders);
      state.open = ['index.html'];
      state.active = 'index.html';
    }
    $('titleProject').textContent = state.projectName;
    $('wsName').textContent = state.projectName.toUpperCase();
    if (state.theme !== 'dark') setTheme(state.theme);

    progress(45, 'loading editor…');
    await new Promise((res) => {
      window.MonacoEnvironment = {
        getWorkerUrl: function () {
          return `data:text/javascript;charset=utf-8,${encodeURIComponent(`
            self.MonacoEnvironment = { baseUrl: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/' };
            importScripts('https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/base/worker/workerMain.js');
          `)}`;
        }
      };
      require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs' } });
      require(['vs/editor/editor.main'], () => res());
    });

    progress(80, 'mounting UI…');
    initEditor();
    bindSettings();
    applyLayout();
    setActiveView(state.activeView || 'explorer');
    renderTree();
    renderTabs();
    loadIntoEditor();
    updateBreadcrumb();
    refreshPreview();
    renderPanel();
    updateProblemsCount();
    updateStatusBar();

    progress(100, 'ready');
    setTimeout(() => boot.classList.add('hidden'), 250);
    logLine('ok', 'CodeLab ready · Ctrl+Shift+P for commands, Ctrl+P for quick open');
  } catch (err) {
    console.error(err);
    if (bootLog) bootLog.textContent = 'error: ' + err.message;
    logLine('error', 'Boot failed: ' + err.message);
    // Hide boot anyway so the user can see what loaded
    setTimeout(() => boot.classList.add('hidden'), 800);
  }
})();
</script>
