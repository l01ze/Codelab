}

function refreshOverlay() {
  const q = overlayInput.value.trim().toLowerCase();
  overlayList.innerHTML = '';
  let items = overlayEntries;
  if (overlayMode === 'commands' || overlayMode === 'files') {
    items = overlayEntries.filter(c => c.label.toLowerCase().includes(q));
  }
  if (!items.length) { overlayList.innerHTML = '<div class="empty">No matching results</div>'; return; }
  items.slice(0, 200).forEach((c, i) => {
    const el = document.createElement('div');
    el.className = 'entry' + (i === overlaySel ? ' sel' : '');
    const iconHtml = (c.icon !== '' && c.icon !== undefined)
      ? c.icon
      : (overlayMode === 'files' ? fileIconSvg(c.label) : '>');
    el.innerHTML = `<span class="icon">${iconHtml}</span><span class="title"></span>${c.key ? `<span class="sub">${c.key}</span>` : ''}`;
    const titleEl = el.querySelector('.title');
    if (q) {
      const idx = c.label.toLowerCase().indexOf(q);
      if (idx >= 0) {
        titleEl.innerHTML = `${escapeHtml(c.label.slice(0, idx))}<mark>${escapeHtml(c.label.slice(idx, idx + q.length))}</mark>${escapeHtml(c.label.slice(idx + q.length))}`;
      } else titleEl.textContent = c.label;
    } else titleEl.textContent = c.label;
    el.onclick = () => {
      if (overlayMode === 'commands') { closeOverlay(); c.fn(); }
      else if (overlayMode === 'files') { closeOverlay(); openFile(c.label); }
    };
    overlayList.appendChild(el);
  });
}
function escapeHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function gotoFileLine(path, line, col) {
  closeOverlay();
  openFile(path);
  setTimeout(() => {
    if (!editor) return;
    editor.revealLineInCenter(line);
    editor.setPosition({ lineNumber: line, column: col || 1 });
    editor.focus();
  }, 60);
}
overlayInput.addEventListener('input', () => { overlaySel = 0; refreshOverlay(); });
overlayInput.addEventListener('keydown', (e) => {
  const items = overlayList.querySelectorAll('.entry');
  if (e.key === 'Escape') { closeOverlay(); e.preventDefault(); }
  else if (e.key === 'ArrowDown') { overlaySel = Math.min(items.length - 1, overlaySel + 1); refreshOverlay(); e.preventDefault(); }
  else if (e.key === 'ArrowUp')   { overlaySel = Math.max(0, overlaySel - 1); refreshOverlay(); e.preventDefault(); }
  else if (e.key === 'Enter') { const el = items[overlaySel]; if (el) el.click(); e.preventDefault(); }
});
overlay.addEventListener('click', (e) => { if (e.target === overlay) closeOverlay(); });

