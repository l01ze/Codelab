/* =========================================================
   Log buffer + Panel
   ========================================================= */
const logBuffer = [];
const MAX_LOG = 2000;

function logLine(kind, text) {
  logBuffer.push({ kind, text, ts: Date.now() });
  if (logBuffer.length > MAX_LOG) logBuffer.shift();
  renderPanel();
  updateProblemsCount();
}

function renderPanel() {
  const tab = state.activePanel;
  if (tab === 'terminal') {
    renderList(consoleEl, logBuffer, () => '<div class="empty">no output yet — press ▶ Run or Ctrl+Enter</div>');
  } else if (tab === 'problems') {
    renderProblems(logBuffer.filter(l => l.kind === 'error' || l.kind === 'warn'));
  } else if (tab === 'output') {
    renderOutput(logBuffer.filter(l => ['info','ok','out'].includes(l.kind)));
  }
}

function renderList(el, lines, emptyHtml) {
  if (!el) return;
  if (!lines.length) { el.innerHTML = emptyHtml(); return; }
  el.innerHTML = '';
  const frag = document.createDocumentFragment();
  for (const l of lines) {
    const div = document.createElement('div');
    div.className = 'line ' + l.kind;
    const ts = new Date(l.ts).toLocaleTimeString('en-GB', { hour12: false });
    div.innerHTML = '<span class="ts"></span><span class="msg"></span>';
    div.querySelector('.ts').textContent = ts;
    div.querySelector('.msg').textContent = l.text;
    frag.appendChild(div);
  }
  el.appendChild(frag);
  el.scrollTop = el.scrollHeight;
}

function renderProblems(items) {
  const el = $('problemsList');
  if (!el) return;
  if (!items.length) { el.innerHTML = '<div class="empty">No problems have been detected in the workspace.</div>'; return; }
  el.innerHTML = '';
  for (const l of items) {
    const d = document.createElement('div');
    d.className = 'prob';
    const icon = l.kind === 'error' ? '✖' : '⚠';
    const cls = l.kind === 'error' ? '' : 'warn';
    d.innerHTML = `<span class="icon ${cls}">${icon}</span><span class="msg"></span><span class="src">console</span>`;
    d.querySelector('.msg').textContent = l.text;
    el.appendChild(d);
  }
}

function renderOutput(items) {
  const el = $('outputList');
  if (!el) return;
  if (!items.length) { el.innerHTML = '<div class="empty">No output yet.</div>'; return; }
  el.innerHTML = '';
  for (const l of items) {
    const d = document.createElement('div');
    d.className = 'out';
    d.textContent = l.text;
    el.appendChild(d);
  }
}

function updateProblemsCount() {
  const errs = logBuffer.filter(l => l.kind === 'error').length;
  const warns = logBuffer.filter(l => l.kind === 'warn').length;
  const c = $('probCount'); if (c) c.textContent = errs + warns;
  const t = $('stProbText'); if (t) t.textContent = `${errs} · ${warns}`;
}

function clearConsole() {
  logBuffer.length = 0;
  renderPanel();
  updateProblemsCount();
}

