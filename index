  { label: 'Editor: Find',                key: 'Ctrl+F',       fn: () => editor && editor.getAction('actions.find').run() },
  { label: 'Editor: Replace',             key: 'Ctrl+H',       fn: () => editor && editor.getAction('editor.action.startFindReplaceAction').run() },
  { label: 'Reload Window',               key: '',             fn: () => location.reload() }
