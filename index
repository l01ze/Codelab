/* =========================================================
   File tree
   ========================================================= */
function buildTree() {
  const root = { name: '', path: '', children: {}, isDir: true };
  const ensure = (parts) => {
    let node = root;
    for (const p of parts) {
      if (!node.children[p]) node.children[p] = { name: p, path: node.path ? node.path + '/' + p : p, children: {}, isDir: true };
      node = node.children[p];
    }
    return node;
  };
  for (const f of state.folders) ensure(f.split('/'));
  for (const f of Object.keys(state.files)) {
    const parts = f.split('/');
    const name = parts.pop();
    const dir = ensure(parts);
    dir.children[name] = { name, path: f, isDir: false };
  }
  return root;
}

function renderTree() {
  if (!treeEl) return;
  treeEl.innerHTML = '';
  renderNode(buildTree(), 0);
  renderOpenEditors();
}

function renderNode(node, depth) {
  const entries = Object.values(node.children).sort((a, b) => {
    if (a.isDir !== b.isDir) return a.isDir ? -1 : 1;
    return a.name.localeCompare(b.name);
  });
  for (const ent of entries) {
    const row = document.createElement('div');
    row.className = 'row' + (ent.path === state.active ? ' active' : '');
    row.dataset.path = ent.path;
    row.dataset.isdir = ent.isDir ? '1' : '0';

    const isOpen = state.expanded.has(ent.path);
    const indentPx = 8 + depth * 8;
    const arrowClass = ent.isDir ? (isOpen ? 'arrow open' : 'arrow') : 'arrow empty';
    const iconHtml = ent.isDir ? svgDir(isOpen) : fileIconSvg(ent.name);

    row.innerHTML = `
      <span class="indent" style="width:${indentPx}px"></span>
      <span class="${arrowClass}">▸</span>
      <span class="icon">${iconHtml}</span>
      <span class="name"></span>
      <span class="row-actions">
        <button class="act-new" title="New File">＋</button>
        <button class="act-rename" title="Rename">✎</button>
        <button class="act-del" title="Delete">🗑</button>
      </span>`;
    row.querySelector('.name').textContent = ent.name;

    row.onclick = (e) => {
      if (e.target.closest('.row-actions')) return;
      if (ent.isDir) {
        state.expanded.has(ent.path) ? state.expanded.delete(ent.path) : state.expanded.add(ent.path);
        renderTree(); scheduleSave();
      } else openFile(ent.path);
    };
    row.ondblclick = (e) => { if (!e.target.closest('.row-actions')) startRename(row, ent); };
    row.oncontextmenu = (e) => { e.preventDefault(); showContextMenu(e.clientX, e.clientY, ent); };

    row.querySelector('.act-new')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const base = ent.isDir ? ent.path + '/' : ent.path.split('/').slice(0,-1).join('/') + '/';
      openModal('new-file', 'New file', base + 'name.ext', '');
    });
    row.querySelector('.act-rename')?.addEventListener('click', (e) => { e.stopPropagation(); startRename(row, ent); });
    row.querySelector('.act-del')?.addEventListener('click', (e) => { e.stopPropagation(); deletePath(ent.path, ent.isDir); });

    if (ent.isDir) {
      row.addEventListener('dragover', (e) => { e.preventDefault(); row.classList.add('drop-target'); });
      row.addEventListener('dragleave', () => row.classList.remove('drop-target'));
      row.addEventListener('drop', async (e) => {
        e.preventDefault(); row.classList.remove('drop-target');
        if (e.dataTransfer && e.dataTransfer.items && e.dataTransfer.items.length)
          await importDataTransfer(e.dataTransfer, ent.path);
      });
    }
    treeEl.appendChild(row);
    if (ent.isDir && isOpen) renderNode(ent, depth + 1);
  }
}

function renderOpenEditors() {
  const el = $('openEditors');
  if (!el) return;
  el.innerHTML = '';
  const c = $('openCount'); if (c) c.textContent = state.open.length;
  for (const p of state.open) {
    const row = document.createElement('div');
    row.className = 'row' + (p === state.active ? ' active' : '');
    row.innerHTML = `
      <span class="indent" style="width:22px"></span>
      <span class="arrow empty">▸</span>
      <span class="icon">${fileIconSvg(p)}</span>
      <span class="name"></span>
      <span class="row-actions"><button title="Close">×</button></span>`;
    row.querySelector('.name').textContent = p.split('/').pop();
    row.title = p;
    row.onclick = (e) => {
      if (e.target.closest('.row-actions')) return;
      state.active = p; renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb();
    };
    row.querySelector('.row-actions button').onclick = (e) => { e.stopPropagation(); closeTab(p); };
    el.appendChild(row);
  }
}

function startRename(row, ent) {
  const nameEl = row.querySelector('.name');
  const oldName = ent.name;
  const input = document.createElement('input');
  input.className = 'rename'; input.value = oldName;
  nameEl.replaceWith(input); input.focus(); input.select();
  const commit = () => {
    const newName = input.value.trim();
    if (!newName || newName === oldName) { renderTree(); return; }
    renamePath(ent.path, newName, ent.isDir);
  };
  input.onblur = commit;
  input.onkeydown = (e) => {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    if (e.key === 'Escape') { input.value = oldName; input.blur(); }
  };
}

function renamePath(oldPath, newName, isDir) {
  const parent = oldPath.split('/').slice(0, -1).join('/');
  const newPath = parent ? parent + '/' + newName : newName;
  if (newPath === oldPath) { renderTree(); return; }
  if (state.files[newPath] != null || state.folders.has(newPath)) {
    logLine('error', `Already exists: ${newPath}`); renderTree(); return;
  }
  if (isDir) {
    const prefix = oldPath + '/';
    if (state.folders.has(oldPath)) { state.folders.delete(oldPath); state.folders.add(newPath); }
    for (const f of [...state.folders]) if (f.startsWith(prefix)) {
      state.folders.delete(f); state.folders.add(newPath + '/' + f.slice(prefix.length));
    }
    for (const f of Object.keys(state.files)) if (f.startsWith(prefix)) {
      const rest = f.slice(prefix.length);
      state.files[newPath + '/' + rest] = state.files[f];
      delete state.files[f];
    }
    const fix = (p) => p === oldPath ? newPath : (p.startsWith(prefix) ? newPath + '/' + p.slice(prefix.length) : p);
    state.open = state.open.map(fix);
    if (state.active) state.active = fix(state.active);
    const ne = new Set(); for (const f of state.expanded) ne.add(fix(f));
    state.expanded = ne;
  } else {
    state.files[newPath] = state.files[oldPath];
    delete state.files[oldPath];
    const idx = state.open.indexOf(oldPath); if (idx >= 0) state.open[idx] = newPath;
    if (state.active === oldPath) state.active = newPath;
  }
  logLine('info', `renamed ${oldPath} → ${newPath}`);
  renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb(); scheduleSave();
}

function deletePath(path, isDir) {
  if (isDir) {
    if (!confirm(`Delete folder "${path}" and everything inside?`)) return;
    const prefix = path + '/';
    state.folders.delete(path);
    for (const f of [...state.folders]) if (f.startsWith(prefix)) state.folders.delete(f);
    for (const f of Object.keys(state.files)) if (f.startsWith(prefix)) {
      delete state.files[f];
      const i = state.open.indexOf(f); if (i >= 0) state.open.splice(i, 1);
      if (state.active === f) state.active = null;
    }
  } else {
    if (!confirm(`Delete "${path}"?`)) return;
    delete state.files[path];
    const i = state.open.indexOf(path); if (i >= 0) state.open.splice(i, 1);
    if (state.active === path) state.active = state.open[state.open.length - 1] || null;
  }
  renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb(); scheduleSave();
  logLine('info', `deleted ${path}`);
}

/* =========================================================
   Tabs
   ========================================================= */
function openFile(path) {
  if (state.files[path] == null) return;
  if (!state.open.includes(path)) state.open.push(path);
  state.active = path;
  renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb(); scheduleSave();
}
function closeTab(path) {
  const i = state.open.indexOf(path);
  if (i < 0) return;
  state.open.splice(i, 1);
  if (state.active === path) state.active = state.open[Math.max(0, i - 1)] || null;
  state.dirty.delete(path);
  renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb(); scheduleSave();
}
function renderTabs() {
  if (!tabsEl) return;
  const actions = tabsEl.querySelector('.tab-actions-panel');
  tabsEl.innerHTML = '';
  for (const p of state.open) {
    const t = document.createElement('div');
    t.className = 'tab' + (p === state.active ? ' active' : '') + (state.dirty.has(p) ? ' dirty' : '');
    t.dataset.path = p;
    t.title = p;
    t.innerHTML = `
      <span class="tab-icon">${fileIconSvg(p)}</span>
      <span class="tab-label"></span>
      <span class="tab-actions">
        <span class="tab-dot"></span>
        <span class="tab-close" title="Close (Ctrl+W)">×</span>
      </span>`;
    t.querySelector('.tab-label').textContent = p.split('/').pop();
    t.onclick = (e) => {
      if (e.target.classList.contains('tab-close')) { e.stopPropagation(); closeTab(p); return; }
      state.active = p; renderTree(); renderTabs(); loadIntoEditor(); updateBreadcrumb();
    };
    t.onauxclick = (e) => { if (e.button === 1) { e.preventDefault(); closeTab(p); } };
    t.oncontextmenu = (e) => { e.preventDefault(); showTabContextMenu(e.clientX, e.clientY, p); };
    t.draggable = true;
    t.ondragstart = (e) => e.dataTransfer.setData('text/tab', p);
    t.ondragover = (e) => e.preventDefault();
    t.ondrop = (e) => {
      e.preventDefault();
      const src = e.dataTransfer.getData('text/tab');
      if (!src || src === p) return;
      const i = state.open.indexOf(src), j = state.open.indexOf(p);
      if (i < 0 || j < 0) return;
      state.open.splice(i, 1);
      state.open.splice(j, 0, src);
      renderTabs(); scheduleSave();
    };
    tabsEl.appendChild(t);
  }
  if (actions) tabsEl.appendChild(actions);
}
function markActiveDirty() {
  if (!state.active) return;
  const t = tabsEl.querySelector(`.tab[data-path="${CSS.escape(state.active)}"]`);
  if (t) t.classList.add('dirty');
}

/* =========================================================
   Breadcrumb
   ========================================================= */
function updateBreadcrumb() {
  const bc = $('breadcrumb');
  if (!bc) return;
  bc.innerHTML = '';
  if (!state.active) return;
  const parts = state.active.split('/');
  parts.forEach((p, i) => {
    if (i > 0) {
      const sep = document.createElement('span');
      sep.className = 'sep'; sep.textContent = '›';
      bc.appendChild(sep);
    }
    const span = document.createElement('span');
    span.className = 'crumb' + (i === parts.length - 1 ? ' last' : '');
    span.textContent = p;
    span.onclick = () => { if (i === parts.length - 1) openFile(state.active); };
    bc.appendChild(span);
  });
}

