/* =========================================================
   Preview
   ========================================================= */
function resolvePath(fromPath, href) {
  if (!href) return null;
  if (/^(https?:|data:|blob:|mailto:|#|\/\/)/i.test(href)) return null;
  href = href.replace(/^\.\//, '').split('?')[0].split('#')[0];
  if (href.startsWith('/')) return href.slice(1);
  const parts = (fromPath ? fromPath.split('/').slice(0, -1) : []).concat(href.split('/'));
  const stack = [];
  for (const p of parts) {
    if (!p || p === '.') continue;
    if (p === '..') stack.pop(); else stack.push(p);
  }
  return stack.join('/');
}
function inlineAssets(html, basePath) {
  html = html.replace(/<link\b[^>]*href=["']([^"']+)["'][^>]*>/gi, (m, href) => {
    if (!/stylesheet/i.test(m)) return m;
    const p = resolvePath(basePath, href);
    if (p != null && state.files[p] != null) return `<style>\n${state.files[p]}\n</style>`;
    return m;
  });
  html = html.replace(/<script\b([^>]*)\bsrc=["']([^"']+)["']([^>]*)>\s*<\/script>/gi, (m, a1, src, a2) => {
    const p = resolvePath(basePath, src);
    if (p != null && state.files[p] != null) return `<script${a1}${a2}>\n${state.files[p]}\n<\/script>`;
    return m;
  });
  html = html.replace(/<img\b([^>]*)\bsrc=["']([^"']+)["']([^>]*)>/gi, (m, a1, src, a2) => {
    const p = resolvePath(basePath, src);
    if (p != null && state.files[p] != null && isBinaryData(state.files[p]))
      return `<img${a1}src="${state.files[p]}"${a2}>`;
    return m;
  });
  return html;
}
function findHtmlEntry() {
  if (state.active && extOf(state.active) === 'html') return state.active;
  if (state.files['index.html'] != null) return 'index.html';
  return Object.keys(state.files).find(n => extOf(n) === 'html') || null;
}
function refreshPreview() {
  const active = state.active;
  const activeExt = active ? extOf(active) : '';
  if (active && activeExt === 'svg') {
    const data = state.files[active];
    previewEl.innerHTML = '';
    const iframe = document.createElement('iframe');
    iframe.setAttribute('sandbox', 'allow-scripts');
    iframe.srcdoc = `<!doctype html><body style="margin:0;background:#fff;display:flex;align-items:center;justify-content:center;height:100vh;">${data}</body>`;
    previewEl.appendChild(iframe);
    $('addr').textContent = active;
    return;
  }
  if (active && (activeExt === 'md' || activeExt === 'markdown')) {
    const html = mdToHtml(state.files[active] || '');
    previewEl.innerHTML = '';
    const iframe = document.createElement('iframe');
    iframe.setAttribute('sandbox', 'allow-scripts');
    iframe.srcdoc = `<!doctype html><html><head><style>
      body{font-family:-apple-system,system-ui,sans-serif;background:#1e1e1e;color:#d4d4d4;
           max-width:780px;margin:40px auto;padding:0 24px;line-height:1.6;}
      h1,h2,h3{color:#569cd6;margin-top:1.4em;}
      h1{border-bottom:1px solid #3c3c3c;padding-bottom:.3em;}
      code{background:#2d2d2d;padding:2px 6px;border-radius:3px;font-family:monospace;font-size:.9em;color:#ce9178;}
      pre{background:#2d2d2d;padding:14px;border-radius:6px;overflow:auto;border:1px solid #3c3c3c;}
      pre code{background:none;padding:0;color:#d4d4d4;}
      a{color:#4fc1ff;} ul,ol{padding-left:1.6em;}
      blockquote{border-left:3px solid #3c3c3c;margin:0;padding-left:16px;color:#858585;}
      table{border-collapse:collapse;} th,td{border:1px solid #3c3c3c;padding:6px 10px;}
      th{background:#2d2d2d;}
    </style></head><body>${html}</body></html>`;
    previewEl.appendChild(iframe);
    $('addr').textContent = active;
    return;
  }
  const entry = findHtmlEntry();
  if (!entry) {
    previewEl.innerHTML = '<div class="placeholder"><div>No HTML file in project</div></div>';
    $('addr').textContent = '—';
    return;
  }
  const raw = state.files[entry] || '';
  const inlined = inlineAssets(raw, entry);
  previewEl.innerHTML = '';
  const iframe = document.createElement('iframe');
  iframe.setAttribute('sandbox', 'allow-scripts allow-modals allow-forms allow-popups allow-same-origin');
  iframe.srcdoc = inlined;
  previewEl.appendChild(iframe);
  $('addr').textContent = entry;
}
let liveTimer = null;
function scheduleLivePreview() {
  if (!state.liveReload) return;
  if (liveTimer) clearTimeout(liveTimer);
  liveTimer = setTimeout(() => {
    const e = extOf(state.active || '');
    if (['html','css','js','svg','md','markdown'].includes(e)) refreshPreview();
  }, 400);
}
$('btnReload').onclick = refreshPreview;
$('btnLive').onclick = () => {
  state.liveReload = !state.liveReload;
  $('btnLive').classList.toggle('on', state.liveReload);
};

function mdToHtml(md) {
  const esc = (s) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const lines = md.split('\n');
  let out = '', inCode = false, inList = false, inOl = false, inTable = false;
  const flushLists = () => {
    if (inList) { out += '</ul>'; inList = false; }
    if (inOl)   { out += '</ol>'; inOl = false; }
    if (inTable){ out += '</table>'; inTable = false; }
  };
  for (const line of lines) {
    if (line.startsWith('```')) {
      if (!inCode) { flushLists(); out += '<pre><code>'; inCode = true; }
      else { out += '</code></pre>'; inCode = false; }
      continue;
    }
    if (inCode) { out += esc(line) + '\n'; continue; }
    let m;
    if (line.trim().startsWith('|') && line.trim().endsWith('|')) {
      const cells = line.trim().slice(1, -1).split('|').map(c => c.trim());
      if (cells.every(c => /^-+$/.test(c))) continue;
      if (!inTable) { flushLists(); out += '<table><tr>' + cells.map(c => `<th>${inline(c)}</th>`).join('') + '</tr>'; inTable = true; }
      else out += '<tr>' + cells.map(c => `<td>${inline(c)}</td>`).join('') + '</tr>';
      continue;
    } else if (inTable) { out += '</table>'; inTable = false; }
    if ((m = line.match(/^###\s+(.*)/))) { flushLists(); out += `<h3>${inline(m[1])}</h3>`; continue; }
    if ((m = line.match(/^##\s+(.*)/)))  { flushLists(); out += `<h2>${inline(m[1])}</h2>`; continue; }
    if ((m = line.match(/^#\s+(.*)/)))   { flushLists(); out += `<h1>${inline(m[1])}</h1>`; continue; }
    if ((m = line.match(/^>\s?(.*)/)))   { flushLists(); out += `<blockquote>${inline(m[1])}</blockquote>`; continue; }
    if ((m = line.match(/^[-*]\s+(.*)/))) { if (!inList) { flushLists(); out += '<ul>'; inList = true; } out += `<li>${inline(m[1])}</li>`; continue; }
    if ((m = line.match(/^\d+\.\s+(.*)/))) { if (!inOl) { flushLists(); out += '<ol>'; inOl = true; } out += `<li>${inline(m[1])}</li>`; continue; }
    if (line.trim() === '') { flushLists(); out += '\n'; continue; }
    flushLists();
    out += `<p>${inline(line)}</p>`;
  }
  flushLists();
  if (inCode) out += '</code></pre>';
  return out;
  function inline(s) {
    return esc(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }
}

/* =========================================================
   Pyodide
   ========================================================= */
let pyodide = null, pyLoading = null, micropip = null;
async function ensurePyodide() {
  if (pyodide) return pyodide;
  if (pyLoading) return pyLoading;
  pyLoading = (async () => {
    logLine('info', 'downloading Pyodide runtime (~10MB, cached afterwards)…');
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/pyodide.js';
    document.head.appendChild(script);
    await new Promise((res, rej) => { script.onload = res; script.onerror = rej; });
    pyodide = await loadPyodide({
      indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/',
      stdout: (s) => logLine('out', s),
      stderr: (s) => logLine('error', s)
    });
    await pyodide.loadPackage('micropip');
    micropip = pyodide.pyimport('micropip');
    logLine('ok', 'Python ' + pyodide.version + ' ready');
    return pyodide;
  })();
  return pyLoading;
}
async function runPython() {
  const py = await ensurePyodide();
  logLine('info', `→ running ${state.active}`);
  try {
    await py.runPythonAsync(state.files[state.active] || '');
    logLine('ok', `finished ${state.active}`);
  } catch (e) { logLine('error', (e && e.message) || String(e)); }
}
$('pipBtn').onclick = doPipInstall;
$('pipInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') doPipInstall(); });
async function doPipInstall() {
  const val = $('pipInput').value.trim();
  if (!val) return;
  $('pipInput').value = '';
  try {
    await ensurePyodide();
    for (const p of val.split(/\s+/)) { logLine('info', `pip install ${p}…`); await micropip.install(p); }
    logLine('ok', 'install complete');
  } catch (e) {
    logLine('error', (e && e.message) || String(e));
    logLine('info', 'Note: packages with native C extensions are not supported in WASM.');
  }
}

/* =========================================================
   JS runner
   ========================================================= */
function runJavaScript() {
  const code = state.files[state.active] || '';
  logLine('info', `→ running ${state.active}`);
  const wrapped = `<!doctype html><html><head><meta charset="utf-8"></head><body><script>
    (function(){
      var post = function(kind, args){
        parent.postMessage({ __codelab:true, kind:kind, args: args.map(function(a){
          try { return typeof a === 'object' ? JSON.stringify(a) : String(a); }
          catch(e){ return String(a); }
        })});
      };
      ['log','info','warn','error','debug'].forEach(function(k){
        var orig = console[k].bind(console);
        console[k] = function(){ post(k === 'debug' ? 'log' : k, Array.from(arguments)); orig.apply(console, arguments); };
      });
      window.onerror = function(msg, src, line){ post('error', [msg + ' (line ' + line + ')']); };
    })();
  <\/script><script>
    try { ${code} } catch (e) { parent.postMessage({ __codelab:true, kind:'error', args:[e.message] }, '*'); }
  <\/script></body></html>`;
  const iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:absolute;width:0;height:0;border:0;visibility:hidden;';
  iframe.setAttribute('sandbox', 'allow-scripts');
  iframe.srcdoc = wrapped;
  document.body.appendChild(iframe);
  setTimeout(() => iframe.remove(), 30000);
  logLine('ok', `dispatched ${state.active}`);
}
window.addEventListener('message', (e) => {
  const d = e.data;
  if (!d || !d.__codelab) return;
  const kind = d.kind === 'error' ? 'error' : d.kind === 'warn' ? 'warn' : d.kind === 'log' ? 'out' : 'info';
  logLine(kind, d.args.join(' '));
});

/* =========================================================
   Run dispatcher
   ========================================================= */
async function runCurrent() {
  if (!state.active) { logLine('warn', 'no file open'); return; }
  const e = extOf(state.active);
  try {
    if (['html','htm','css','svg','md','markdown'].includes(e)) {
      refreshPreview();
      $('secondary').classList.remove('hidden');
      $('splitterSecondary').style.display = '';
      logLine('ok', `preview refreshed (${state.active})`);
    } else if (e === 'py' || e === 'pyw') {
      await runPython();
      openPanel('terminal');
    } else if (['js','mjs','cjs'].includes(e)) {
      runJavaScript();
      openPanel('terminal');
    } else if (e === 'json') {
