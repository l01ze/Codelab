$('btnSearchClear').onclick = () => { $('searchInput').value = ''; $('replaceInput').value = ''; $('search-results').innerHTML = '<div class="empty">Search across files in the workspace</div>'; };
$('btnReplaceAll').onclick = () => {
  const q = $('searchInput').value;
  const r = $('replaceInput').value;
  if (!q) return;
  let count = 0;
  for (const path of Object.keys(state.files)) {
    const content = state.files[path];
    if (typeof content !== 'string' || isBinaryData(content)) continue;
    const re = buildSearchRegex(q);
    if (!re) continue;
    const before = content;
    state.files[path] = content.replace(re, r);
    if (state.files[path] !== before) count++;
  }
  logLine('ok', `replaced in ${count} file${count === 1 ? '' : 's'}`);
  runSearch();
  if (state.active) loadIntoEditor();
  scheduleSave();
};
$('btnScmRefresh').onclick = () => logLine('info', 'Source control is not connected in this environment.');
$('btnSearchRefresh').onclick = runSearch;

function buildSearchRegex(q) {
  try {
    const flags = 'g' + (searchOpts.case ? '' : 'i');
    let pattern = searchOpts.regex ? q : q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    if (searchOpts.word) pattern = '\\b' + pattern + '\\b';
    return new RegExp(pattern, flags);
  } catch { return null; }
}
function runSearch() {
  const q = $('searchInput').value;
  const el = $('search-results');
  if (!q || q.length < 1) { el.innerHTML = '<div class="empty">Search across files in the workspace</div>'; return; }
  const re = buildSearchRegex(q);
  if (!re) { el.innerHTML = '<div class="empty">Invalid regular expression</div>'; return; }
  const results = [];
  let totalMatches = 0;
  for (const [path, content] of Object.entries(state.files)) {
    if (typeof content !== 'string' || isBinaryData(content)) continue;
    const lines = content.split('\n');
    const fileMatches = [];
    lines.forEach((line, i) => {
      re.lastIndex = 0;
      let m;
      while ((m = re.exec(line)) !== null) {
        fileMatches.push({ line: i + 1, col: m.index + 1, text: line });
        totalMatches++;
        if (m.index === re.lastIndex) re.lastIndex++;
        if (fileMatches.length > 200) break;
      }
    });
    if (fileMatches.length) results.push({ path, matches: fileMatches });
  }
  el.innerHTML = '';
  if (!results.length) { el.innerHTML = `<div class="status">No results found in ${Object.keys(state.files).length} files</div>`; return; }
  const head = document.createElement('div');
  head.className = 'status';
  head.textContent = `${totalMatches} result${totalMatches === 1 ? '' : 's'} in ${results.length} file${results.length === 1 ? '' : 's'}`;
  el.appendChild(head);

  for (const r of results) {
    const g = document.createElement('div');
    g.className = 'file-group';
    const dir = r.path.split('/').slice(0, -1).join('/');
    const name = r.path.split('/').pop();
    const fh = document.createElement('div');
    fh.className = 'file-head';
    fh.innerHTML = `<span>${fileIconSvg(name)}</span><span>${name}</span><span class="path">${dir}</span><span style="margin-left:auto;color:var(--fg-muted);font-size:11px;">${r.matches.length}</span>`;
    fh.onclick = () => openFile(r.path);
    g.appendChild(fh);
    for (const m of r.matches.slice(0, 20)) {
      const row = document.createElement('div');
      row.className = 'match';
      const re2 = buildSearchRegex(q);
      if (re2) {
        re2.lastIndex = 0;
        const match = re2.exec(m.text);
        if (match) {
          const before = m.text.slice(0, match.index);
          const hit = m.text.slice(match.index, match.index + match[0].length);
          const after = m.text.slice(match.index + match[0].length);
          row.innerHTML = `${m.line}: ${before.replace(/</g,'&lt;')}<mark>${hit.replace(/</g,'&lt;')}</mark>${after.replace(/</g,'&lt;')}`;
        } else row.textContent = `${m.line}: ${m.text}`;
      }
      row.onclick = () => gotoFileLine(r.path, m.line, m.col);
      g.appendChild(row);
    }
    el.appendChild(g);
  }
}

