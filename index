const svgFile = (color, letter) => `<svg viewBox="0 0 16 16" fill="${color}"><path d="M4 1h5l4 4v9a1 1 0 01-1 1H4a1 1 0 01-1-1V2a1 1 0 011-1z" opacity=".25"/><path d="M9 1l4 4h-3a1 1 0 01-1-1V1z"/><text x="8" y="12" text-anchor="middle" font-size="6" font-weight="700" fill="${color}" font-family="sans-serif">${letter}</text></svg>`;
const svgDir = (open) => `<svg viewBox="0 0 16 16" fill="#dcb67a"><path d="M1.5 3a1 1 0 011-1h3l1.5 1.5h6a1 1 0 011 1v7a1 1 0 01-1 1h-11a1 1 0 01-1-1V3z"/></svg>`;
const svgImage = `<svg viewBox="0 0 16 16" fill="#a074c4"><rect x="2" y="3" width="12" height="10" rx="1" opacity=".2"/><path d="M3 11l3-3 2 2 3-4 3 4v2H3v-1z"/><circle cx="5.5" cy="6" r="1"/></svg>`;
const svgUnknown = `<svg viewBox="0 0 16 16" fill="#c5c5c5"><path d="M4 1h5l4 4v9a1 1 0 01-1 1H4a1 1 0 01-1-1V2a1 1 0 011-1z" opacity=".4"/></svg>`;

function fileIconSvg(name) {
  const ext = (name.split('.').pop() || '').toLowerCase();
  switch (ext) {
    case 'html': case 'htm': return svgFile('#e44d26', '<>');
    case 'css': case 'scss': case 'less': return svgFile('#42a5f5', '#');
    case 'js': case 'mjs': case 'cjs': return svgFile('#f7df1e', 'JS');
    case 'jsx': return svgFile('#61dafb', 'JX');
    case 'ts': return svgFile('#3178c6', 'TS');
    case 'tsx': return svgFile('#3178c6', 'TX');
    case 'py': case 'pyw': return svgFile('#3572a5', 'Py');
    case 'json': return svgFile('#cbcb41', '{}');
    case 'md': case 'markdown': return svgFile('#519aba', 'M');
    case 'svg': return svgImage;
    case 'png': case 'jpg': case 'jpeg': case 'gif': case 'webp': return svgImage;
    case 'yml': case 'yaml': return svgFile('#cb171e', 'Y');
    case 'sh': case 'bash': return svgFile('#89e051', '$');
    default: return svgUnknown;
  }
}

const extOf = (path) => (path.split('.').pop() || '').toLowerCase();
const langOf = (path) => state.langOverride[path] || LANG_BY_EXT[extOf(path)] || 'plaintext';
const isBinaryData = (v) => typeof v === 'string' && v.startsWith('data:');

/* =========================================================
   Persistence
   ========================================================= */
function openDB() {
  return new Promise((res, rej) => {
    const r = indexedDB.open('codelab', 4);
    r.onupgradeneeded = () => {
      const db = r.result;
      if (!db.objectStoreNames.contains('kv')) db.createObjectStore('kv');
    };
    r.onsuccess = () => res(r.result);
    r.onerror = () => rej(r.error);
  });
}
let saveTimer = null;
function scheduleSave() {
  if (saveTimer) clearTimeout(saveTimer);
  saveTimer = setTimeout(saveAll, 400);
}
async function saveAll() {
  try {
    const db = await openDB();
    const tx = db.transaction('kv', 'readwrite');
    tx.objectStore('kv').put({
      files: state.files,
      folders: [...state.folders],
      langOverride: state.langOverride,
      expanded: [...state.expanded],
      open: state.open,
      active: state.active,
      projectName: state.projectName,
      theme: state.theme,
      fontSize: state.fontSize,
      minimap: state.minimap,
      wordWrap: state.wordWrap,
      tabSize: state.tabSize,
      sidebarW: state.sidebarW,
      secondaryW: state.secondaryW,
      panelH: state.panelH,
      activeView: state.activeView
    }, 'state');
    state.dirty.clear();
    document.querySelectorAll('#tabs .tab.dirty').forEach(t => t.classList.remove('dirty'));
  } catch {}
}
async function loadAll() {
  try {
    const db = await openDB();
    const tx = db.transaction('kv', 'readonly');
    const req = tx.objectStore('kv').get('state');
    return await new Promise(res => { req.onsuccess = () => res(req.result); req.onerror = () => res(null); });
  } catch { return null; }
}

