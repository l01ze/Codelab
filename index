let searchOpts = { case: false, word: false, regex: false };
document.querySelectorAll('.search-input-wrap .opt[data-opt]').forEach(b => {
  b.onclick = () => {
    const o = b.dataset.opt;
    searchOpts[o] = !searchOpts[o];
    b.classList.toggle('active', searchOpts[o]);
    runSearch();
  };
});
