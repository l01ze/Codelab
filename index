}, 6000);

/* Global error trap */
window.addEventListener('error', (e) => {
  if (boot && !boot.classList.contains('hidden')) {
    bootLog.textContent = 'error: ' + (e.message || e.type);
  }
  console.error('[CodeLab]', e.error || e.message);
});

